{
  "name": "www_lnkdrp",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:webpack": "WATCHPACK_POLLING=true WATCHPACK_POLLING_INTERVAL=8000 CHOKIDAR_USEPOLLING=true CHOKIDAR_INTERVAL=8000 next dev --webpack -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "cron:doc-metrics": "tsx --env-file=.env.local scripts/cron/cron.doc-metrics.ts",
    "cron:stripe-credits-reconcile": "tsx --env-file=.env.local scripts/cron/cron.stripe-credits-reconcile.ts",
    "cron:stripe-credits-report": "tsx --env-file=.env.local scripts/cron/cron.stripe-credits-report.ts",
    "cron:credits-cycle-reconcile": "tsx --env-file=.env.local scripts/cron/cron.credits-cycle-reconcile.ts",
    "cron:usage-agg-reconcile": "tsx --env-file=.env.local scripts/cron/cron.usage-agg-reconcile.ts",
    "cron:notification-emails": "tsx --env-file=.env.local scripts/cron/cron.notification-emails.ts",
    "cron:plan-limits": "tsx --env-file=.env.local scripts/cron/cron.plan-limits.ts",
    "realtime": "tsx --env-file=.env.local realtime/server.ts",
    "realtime:prod": "node --import tsx realtime/server.ts",
    "mcp": "tsx --env-file=.env.local mcp/src/main.ts",
    "mcp:prod": "node --import tsx mcp/src/main.ts",
    "lint": "eslint",
    "blob:test": "node scripts/test-vercel-blob.mjs",
    "mongo:clear": "node scripts/mongo-clear.mjs",
    "sharelinks:backfill": "tsx --env-file=.env.local scripts/sharelinks-backfill.ts",
    "mongo:clear:ai-runs-requests": "node scripts/mongo-clear-ai-runs-and-requests.mjs",
    "metrics:rollup:dev": "tsx scripts/rollup-doc-metrics.ts --interval 10000",
    "metrics:rollup:once": "tsx scripts/rollup-doc-metrics.ts --once",
    "test:pdf2png": "node scripts/pdf-first-page-to-png.mjs",
    "test:pdf2txt": "node scripts/pdf-to-text.mjs",
    "test:ai-extract": "tsx scripts/test-ai-extract.ts",
    "test:notification-emails": "tsx scripts/notifications-send-emails.ts",
    "tests:agent": "tsx tests/agent/agent.cli.ts",
    "tests:agent:cli": "tsx tests/agent/agent.cli.ts",
    "tests:agent:vitest": "vitest run --config tests/agent/vitest.config.ts",
    "tests:upload:vitest": "vitest run --config tests/upload/vitest.config.ts",
    "tests:credits:vitest": "vitest run --config tests/credits/vitest.config.ts",
    "tests:lib:vitest": "vitest run --config tests/lib/vitest.config.ts",
    "tests:routes": "node scripts/tests-routes.mjs",
    "tests:benchmark": "tsx scripts/tests-benchmark.ts",
    "audit:blob-urls": "tsx --env-file=.env.local scripts/audit-stored-blob-urls.ts",
    "verify:analytics": "tsx --env-file=.env.local scripts/verify-share-analytics.ts",
    "sharelinks:analytics-backfill": "tsx --env-file=.env.local scripts/sharelinks-analytics-backfill.ts",
    "cron:analytics-reconcile": "tsx --env-file=.env.local scripts/cron/cron.analytics-reconcile.ts",
    "cron:credits-purchase-expiry": "tsx --env-file=.env.local scripts/cron/cron.credits-purchase-expiry.ts",
    "cron:account-purge": "tsx --env-file=.env.local scripts/cron/cron.account-purge.ts",
    "test:account-deletion": "tsx --env-file=.env.local scripts/test-account-deletion.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.0",
    "@babel/runtime": "^7.26.10",
    "@heroicons/react": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/canvas": "^0.1.84",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.0.0",
    "ai": "^5.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "mongoose": "^8.10.0",
    "next": "16.0.10",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.4.449",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.4",
    "stripe": "^20.1.0",
    "ws": "^8.21.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "eslint-plugin-jsdoc": "^61.7.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}

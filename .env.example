# lnkdrp — environment template. Copy to .env.local for development. Production values live in
# Vercel (web app) and in the host of the two Node services (realtime, mcp). Never commit secrets.
# See DEPLOY.md for which service needs which variable.

# ─── Web app (Next.js on Vercel) ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3001            # Public origin; emails, OG tags, share URLs, MCP guides
NEXTAUTH_URL=http://localhost:3001                    # Same as the site URL
NEXTAUTH_SECRET=                                      # openssl rand -base64 32
GOOGLE_CLIENT_ID=                                     # Google OAuth (redirect: <site>/api/auth/callback/google)
GOOGLE_CLIENT_SECRET=

MONGODB_URI=mongodb://127.0.0.1:27018/lnkdrp_dev?directConnection=true&replicaSet=rs0   # Must be a replica set (change streams)
# MONGODB_DB_NAME=                                    # Only if the URI has no database name

BLOB_READ_WRITE_TOKEN=                                # Vercel Blob (PDF storage)
# VERCEL_BLOB_CALLBACK_URL=                           # Only when the app is not reachable at NEXT_PUBLIC_SITE_URL (e.g. ngrok)

OPENAI_API_KEY=                                       # Summaries and AI compare

STRIPE_SECRET_KEY=                                    # sk_live_… in production, sk_test_… locally
STRIPE_WEBHOOK_SECRET=                                # From the webhook endpoint (<site>/api/stripe/webhook)
STRIPE_PRICE_ID=                                      # Pro, $29/month licensed price
STRIPE_PRICE_ID_ANNUAL=                               # Pro, $290/year licensed price (12 months for 10); optional, unset = monthly only
STRIPE_AI_CREDITS_PRICE_ID=                           # On-demand credits, $0.10/credit metered price on the ai_credits meter
STRIPE_CREDITS_METER_EVENT_NAME=ai_credits            # Billing Meter event_name attached to the metered price
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SUCCESS_URL= / STRIPE_CANCEL_URL=            # Default to <site>/billing/success and <site>/pricing

CRON_SECRET=                                          # Vercel Cron sends Authorization: Bearer $CRON_SECRET (openssl rand -hex 32)
PLAIN_REQUEST_SIGNING_SECRET=                         # Plain → Settings → Request Signing; verifies Plain-Request-Signature on /api/support/plain/customer-cards. Unset = endpoint refuses everything
NEXT_PUBLIC_PLAIN_CHAT_APP_ID=                        # Plain → Settings → Chat → the chat app id. Unset = no widget, "Contact us" links stay mailto
PLAIN_CHAT_SECRET=                                    # Same page. Signs the signed-in user's email for the widget; unset = visitors verify by emailed code
# Per-purpose secrets. Set each one to its own value (openssl rand -base64 32). Left blank, the key
# is DERIVED from NEXTAUTH_SECRET with HKDF rather than being NEXTAUTH_SECRET itself, so a component
# holding one of these keys cannot walk back to the session secret. Setting one to a literal copy of
# NEXTAUTH_SECRET counts as leaving it blank. The share-password key is the exception below.
LNKDRP_SHARE_PASSWORD_SECRET=                         # Falls back to NEXTAUTH_SECRET VERBATIM — rotating it makes stored share passwords undecryptable (needs a re-encryption migration)
LNKDRP_ORG_INVITE_TOKEN_SECRET=                       # Falls back to NEXTAUTH_SECRET verbatim (invite tokens are AES-encrypted at rest)
LNKDRP_NOTIFICATION_TOKEN_SECRET=                     # View-notification / unsubscribe token HMAC; falls back to a key derived from NEXTAUTH_SECRET
REALTIME_SECRET=                                      # Ticket HMAC shared with the realtime + mcp services; falls back to a key derived from NEXTAUTH_SECRET

NOTIFICATION_EMAIL_FROM="LinkDrop <hi@lnkdrp.com>"    # Transactional email sender
# The credential that actually sends. Without it every send throws at runtime;
# set EMAIL_TRANSPORT=console to print mail instead of sending it.
RESEND_API_KEY=
# From address for workspace invites, when it differs from the notification sender.
INVITE_EMAIL_FROM=
# EMAIL_TRANSPORT=                                    # Email provider selection (see docs/DEV.md)

NEXT_PUBLIC_REALTIME_URL=ws://localhost:8788          # Realtime server; unset = polling only. Production: wss://realtime.lnkdrp.com
# REALTIME_DISABLED=1                                 # Kill switch: /api/realtime/ticket answers "poll instead" at request time, no rebuild
# NEXT_PUBLIC_MCP_URL=http://localhost:8787/mcp       # MCP endpoint shown in /connect and /mcp guides; production default is https://mcp.lnkdrp.com/mcp
# NEXT_PUBLIC_FEATURE_REQUESTS=1                      # Re-enable the hidden Requests feature (not released)
# NEXT_PUBLIC_FEATURE_CREDITS=0                       # Hide the credits UI (on by default)
# API_TEST_BYPASS_AUTH=1                              # DEV ONLY: temp-user actor without a session. Never in production.
# DEBUG_LEVEL=1                                       # Server debug logging verbosity

# Vercel deployment insight (/a/deployments). OPTIONAL and READ-ONLY: the admin page calls the
# Vercel REST API to show what built and when. Leave all three blank and nothing breaks; the page
# says "not configured" and every other admin screen works exactly as before. Nothing else in the
# product reads these. The token needs read access only (Vercel account settings, Tokens).
# VERCEL_API_TOKEN=                                   # Read-only Vercel API token. Never logged, never returned to the browser.
# VERCEL_PROJECT_ID=                                  # prj_… (Vercel project settings, or .vercel/project.json after `vercel link`)
# VERCEL_TEAM_ID=                                     # team_… Required only when the project belongs to a team, not a personal account

# Slack (docs/prds/lnkdrp-slack.md). OPTIONAL: the app that "Add to Slack" installs from, created at
# api.slack.com with the incoming-webhook scope and this deployment's /api/slack/oauth/callback as a
# redirect URL. Leave both blank and the Integrations page says Slack is not set up; nothing else changes.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# LNKDRP_SLACK_SECRET=                                # Optional master for the webhook-URL encryption and OAuth state; blank = derived from NEXTAUTH_SECRET

# ─── Realtime server (realtime/server.ts, own host) ────────────────────────────────────────────
# REALTIME_MONGODB_URI (read-only user on the same database; falls back to MONGODB_URI), REALTIME_SECRET (same value as the web app)
# REALTIME_MONGODB_URI=
REALTIME_PORT=8788

# ─── MCP server (mcp/src/main.ts, own host) ────────────────────────────────────────────────────
# LNKDRP_API_URL=https://lnkdrp.com                   # Base URL of the web app the MCP server calls (defaults by NODE_ENV)
MCP_PORT=8787
# MCP_PUBLIC_URL=https://mcp.lnkdrp.com               # Advertised URL (RFC 9728 metadata)
# NEXT_PUBLIC_REALTIME_URL + REALTIME_SECRET          # Optional: share_pdf waits for "ready" over the socket instead of polling
# LNKDRP_API_KEY=                                     # Only for `--stdio` mode
